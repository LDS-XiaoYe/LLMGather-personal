PORT=3000

# ===== 数据库配置（MySQL 必选）=====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=llmgather
# 注意：MySQL 空库会由项目自动创建，无需手动建库建表

# ===== 邮件服务配置（邮箱注册必选）=====
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
SMTP_FROM_NAME=LLM Gather
SMTP_FROM_ADDRESS=your-email@example.com

# Platform API key (required)
PLATFORM_API_KEY=replace-with-strong-key

# ===== Provider 配置 =====
# 所有 Provider 设置（API Key、端点、模型列表、超时等）均通过管理后台管理
# 首次启动时系统会自动创建 4 个默认 Provider（qwen/glm/deepseek/xiaomi-mimo）

# ===== 支付宝当面付配置 =====
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_NOTIFY_URL=
ALIPAY_SIGN_TYPE=RSA2

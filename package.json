{
  "name": "llm-gather-workspace",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "deployment-agent"
  ],
  "scripts": {
    "deploy:init": "node scripts/init-deployment.cjs",
    "deploy": "node scripts/deploy.cjs",
    "deploy:dev": "node scripts/deploy.cjs --dev",
    "test:deployment": "node --test scripts/init-deployment.test.cjs",
    "dev:backend": "npm --prefix backend run start:dev",
    "build:backend": "npm --prefix backend run build",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "db:backup": "node backend/scripts/export-sanitized-sql.cjs"
  },
  "dependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1"
  }
}

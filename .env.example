# Use this file with Docker: docker compose --env-file .env.docker up -d
# Copy .env.docker.example to .env.docker for full app configuration.

# P0 workflow runtime and durable MySQL checkpoints (keep encryption key across restarts)
WORKFLOW_ENGINE=langgraph
CHECKPOINT_ENCRYPTION_KEY=replace-with-a-random-secret-of-at-least-32-characters
WORKFLOW_AUTO_RECOVER=true
WORKFLOW_RUN_CONCURRENCY=4
WORKFLOW_NODE_CONCURRENCY=8
WORKFLOW_TIMEOUT_MS=120000
WORKFLOW_MAX_STEPS=256
WORKFLOW_MAX_NODE_BYTES=1048576

# Native semantic RAG: Qdrant is private to the Docker network
NATIVE_RAG_BACKEND=qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=replace-with-a-random-qdrant-key
# Optional existing managed Provider name; otherwise use endpoint/key below.
EMBEDDING_PROVIDER_NAME=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_REVISION=1
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CONCURRENCY=2
EMBEDDING_TIMEOUT_MS=30000
EMBEDDING_RETRIES=2
# Only for an explicit legacy-write rollback strategy; never imported into Qdrant.
RAG_LEGACY_WRITE_VECTORS=false
WORKFLOW_NODE_TIMEOUT_MS=60000

PORT=3000

# ===== 数据库配置（MySQL 必选）=====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=llmgather
# 注意：MySQL 空库会由项目自动创建，无需手动建库建表

# ===== 邮件服务配置（邮箱注册必选）=====
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
SMTP_FROM_NAME=LLM Gather
SMTP_FROM_ADDRESS=your-email@example.com

# Platform API key (required)
PLATFORM_API_KEY=replace-with-strong-key

# ===== Provider 配置 =====
# 所有 Provider 设置（API Key、端点、模型列表、超时等）均通过管理后台管理
# 首次启动时系统会自动创建 4 个默认 Provider（qwen/glm/deepseek/xiaomi-mimo）

# ===== 支付宝当面付配置 =====
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_NOTIFY_URL=
ALIPAY_SIGN_TYPE=RSA2

# P0 workflow runtime and durable MySQL checkpoints (keep encryption key across restarts)
WORKFLOW_ENGINE=langgraph
CHECKPOINT_ENCRYPTION_KEY=replace-with-a-random-secret-of-at-least-32-characters
WORKFLOW_AUTO_RECOVER=true
WORKFLOW_RUN_CONCURRENCY=4
WORKFLOW_NODE_CONCURRENCY=8
WORKFLOW_TIMEOUT_MS=120000
WORKFLOW_MAX_STEPS=256
WORKFLOW_MAX_NODE_BYTES=1048576

# Native semantic RAG: Qdrant is private to the Docker network
NATIVE_RAG_BACKEND=qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=replace-with-a-random-qdrant-key
# Optional existing managed Provider name; otherwise use endpoint/key below.
EMBEDDING_PROVIDER_NAME=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_REVISION=1
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CONCURRENCY=2
EMBEDDING_TIMEOUT_MS=30000
EMBEDDING_RETRIES=2
# Only for an explicit legacy-write rollback strategy; never imported into Qdrant.
RAG_LEGACY_WRITE_VECTORS=false
WORKFLOW_NODE_TIMEOUT_MS=60000
# Model nodes are approved in the admin UI; default Compose node needs no manual address/credential.

# Long-term memory: MySQL primary store; optional derived Qdrant index.
# Disabled: no embedding/Qdrant calls for memory, keyword retrieval still works.
MEMORY_SEMANTIC_INDEX_ENABLED=false
# Optional managed instance (e.g. BGE-M3); blank reuses the EMBEDDING_* configuration.
MEMORY_EMBEDDING_INSTANCE_ID=

# MySQL startup: finite retries; schema + versioned missing-only settings seed before Ready.
MYSQL_BOOTSTRAP_RETRIES=10
MYSQL_BOOTSTRAP_RETRY_DELAY_MS=2000
MYSQL_CONNECT_TIMEOUT_MS=5000
MYSQL_BOOTSTRAP_LOCK_TIMEOUT_SECONDS=60

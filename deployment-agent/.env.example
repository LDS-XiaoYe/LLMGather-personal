# Generate once; register these same values via System settings / Model services.
AGENT_ID=00000000-0000-4000-8000-000000000001
AGENT_TOKEN=replace-with-a-random-credential-of-at-least-32-characters
AGENT_HOST=127.0.0.1
AGENT_PORT=19090
AGENT_DATA_DIR=
HF_TOKEN=
MODELSCOPE_TOKEN=
# Remote native Agent requires TLS, backend hostname allowlist and a trusted cert.
AGENT_TLS_CERT=
AGENT_TLS_KEY=
# Native GPU nodes use host installer (NVIDIA nvidia-smi discovery / macOS Metal).
AGENT_PYTHON=python3

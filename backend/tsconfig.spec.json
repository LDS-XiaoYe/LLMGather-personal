{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "sourceMap": true,
    "skipLibCheck": true,
    "strict": false,
    "moduleResolution": "node",
    "types": ["jest", "node"],
    "esModuleInterop": true
  },
  "include": ["src/**/*.ts"]
}
